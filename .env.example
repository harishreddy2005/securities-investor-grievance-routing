# Copy to .env. No API keys needed for Phase 0.
LLM_PROVIDER=stub
EMBEDDING_PROVIDER=chroma
EMBEDDING_CACHE_DIR=/home/router/.cache/chroma
# Chroma's bundled local semantic embedding downloads weights on first ingest.
# test_hash is only for offline software tests; it is not semantic retrieval.
REDIS_URL=redis://redis:6379/0
LLM_STUB_URL=http://llm-stub:8001
INDEX_DIR=/data/index
CORPUS_DIR=/app/corpus/raw
QUEUE_NAME=grievances
JOB_TIMEOUT=180
RESULT_TTL=604800
STUB_DELAY_SECONDS=0.1
STUB_FAIL=false
