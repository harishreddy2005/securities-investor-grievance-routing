{
  "uid": "grievance-phase2",
  "title": "Grievance Routing - Phase 2",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "grievance",
    "phase2"
  ],
  "panels": [
    {
      "id": 1,
      "title": "API requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grievance-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(grievance_http_requests_total{job=\"api\"}[5m]))",
          "legendFormat": "{{job}} {{agent}} {{outcome}} {{dependency}} {{state}} {{code}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
