# Copy to .env. No API keys needed for Phase 0.
LLM_PROVIDER=stub
EMBEDDING_PROVIDER=chroma
EMBEDDING_CACHE_DIR=/home/router/.cache/chroma
# Chroma's bundled local semantic embedding downloads weights on first ingest.
# test_hash is only for offline software tests; it is not semantic retrieval.
REDIS_URL=redis://redis:6379/0
LLM_STUB_URL=http://llm-stub:8001
INDEX_DIR=/data/index
CORPUS_DIR=/app/corpus/raw
QUEUE_NAME=grievances
JOB_TIMEOUT=180
RESULT_TTL=604800
STUB_DELAY_SECONDS=0.1
STUB_FAIL=false
LLM_TIMEOUT=10
RETRIEVAL_TIMEOUT=15
REDIS_TIMEOUT=3
DEPENDENCY_RETRIES=2
RETRY_BASE_SECONDS=0.2
RETRY_CAP_SECONDS=2
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=10
TELEMETRY_ENABLED=true
OTLP_ENDPOINT=http://jaeger:4318/v1/traces
TELEMETRY_EXPORT_TIMEOUT=2
# Run python scripts/configure_local.py to generate a local password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
